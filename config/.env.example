# ============================================================
# THE AUTOMATOR - ENVIRONMENT CONFIGURATION
# ============================================================
# REPLACE ALL VALUES BELOW WITH YOUR ACTUAL API KEYS
# ============================================================

# --- ANTHROPIC (REQUIRED - all content generation) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- OPENAI (OPTIONAL - DALL-E 3 image generation) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- STABILITY AI (OPTIONAL - fallback image generation) ---
STABILITY_API_KEY=your_stability_api_key_here

# --- PEXELS (OPTIONAL - stock photos/videos) ---
PEXELS_API_KEY=your_pexels_api_key_here

# --- UNSPLASH (OPTIONAL - stock photos) ---
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# --- INSTAGRAM (REQUIRED for Instagram posting) ---
# Get from: https://developers.facebook.com/apps/
INSTAGRAM_ACCESS_TOKEN=your_instagram_long_lived_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# --- TIKTOK (REQUIRED for TikTok posting) ---
# Get from: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_OPEN_ID=your_tiktok_open_id

# --- YOUTUBE (REQUIRED for YouTube posting) ---
# Get from: https://console.cloud.google.com/
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token

# --- TWITTER/X (REQUIRED for Twitter posting) ---
# Get from: https://developer.twitter.com/
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# --- LINKEDIN (REQUIRED for LinkedIn posting) ---
# Get from: https://www.linkedin.com/developers/apps
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_PERSON_ID=your_linkedin_person_urn

# --- FACEBOOK (REQUIRED for Facebook posting) ---
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# --- SUPABASE (OPTIONAL - cloud backup) ---
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# --- REDDIT (OPTIONAL - Scout Bot source) ---
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# --- APP INTERNAL ---
APP_DATA_PATH=./data
MEDIA_PATH=./media
LOG_LEVEL=INFO
