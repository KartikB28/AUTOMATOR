{
  "name": "the-automator",
  "version": "1.0.0",
  "description": "Fully autonomous content automation desktop app",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently \"npm run frontend\" \"npm run electron\"",
    "frontend": "cd frontend && npm run dev",
    "electron": "wait-on http://localhost:5173 && electron .",
    "build": "cd frontend && npm run build && electron-builder",
    "install-all": "npm install && cd frontend && npm install && cd ../backend && pip install -r requirements.txt && python -m playwright install chromium"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.automator.app",
    "productName": "The Automator",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/**/*",
      "config/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
